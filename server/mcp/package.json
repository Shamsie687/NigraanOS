{
  "name": "nigraan-mcp-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": ["dist/server/mcp/src/", "dist/src/"],
  "scripts": {
    "validate:infra": "node ../../infra/mcp/validate.mjs",
    "build": "tsc",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/server/mcp/tests/*.test.js",
    "dev": "npm run build && node --env-file-if-exists=../../.env dist/server/mcp/src/local.js",
    "dev:simulator": "npm run build && node --env-file-if-exists=../../.env dist/server/mcp/src/local.js --simulator",
    "dev:simulator:localhost": "npm run build && node --env-file-if-exists=../../.env dist/server/mcp/src/local.js --simulator --localhost",
    "client": "npm run build && node dist/server/mcp/src/localClient.js"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1146.0",
    "@aws-sdk/client-kms": "3.1146.0",
    "@aws-sdk/lib-dynamodb": "3.1146.0",
    "@modelcontextprotocol/sdk": "1.32.0",
    "@node-oauth/oauth2-server": "5.3.0",
    "@supabase/supabase-js": "2.117.2",
    "express": "5.1.0",
    "serverless-http": "4.0.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "5.0.5",
    "@types/node": "24.10.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
